{
  "name": "respect_portal",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prod": "ng serve  --configuration=production",
    "build": "node ./scripts/set-build-timestamp.js && ng build && node ./scripts/fix-css-paths.js && node ./scripts/apply-csp.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "update-context": "node ./scripts/update-context.js",
    "update-lib": "powershell -ExecutionPolicy Bypass -File ./scripts/update-library.ps1"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.11",
    "@angular/common": "^20.3.11",
    "@angular/compiler": "^20.3.11",
    "@angular/core": "^20.3.11",
    "@angular/forms": "^20.3.11",
    "@angular/localize": "^20.3.11",
    "@angular/platform-browser": "^20.3.11",
    "@angular/platform-browser-dynamic": "^20.3.11",
    "@angular/router": "^20.3.11",
    "@halloverden/ngx-cookiebot": "^7.0.0",
    "@json-editor/json-editor": "^2.12.0",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ng-select/ng-select": "^20.7.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "bootstrap": "^5.3.6",
    "dompurify": "^3.3.0",
    "ng-inline-svg-2": "^20.0.1",
    "ng-recaptcha-2": "^16.0.1",
    "prettier": "^3.6.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.11",
    "@angular/cli": "^20.3.11",
    "@angular/compiler-cli": "^20.3.11",
    "@types/dompurify": "^3.0.5",
    "@types/jasmine": "~3.8.0",
    "@types/node": "^12.11.1",
    "jasmine-core": "~3.8.0",
    "karma": "~6.4.0",
    "karma-coverage": "~2.0.3",
    "karma-chrome-launcher": "~3.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "typescript": "~5.8.3"
  }
